{
  "name": "ez-php/graphql-subscriptions",
  "version": "2.6.3",
  "description": "GraphQL subscriptions over ez-php/websocket (graphql-transport-ws), fed by ez-php/broadcast",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["graphql", "subscriptions", "websocket", "graphql-transport-ws", "php", "ez-php"],
  "homepage": "https://github.com/ez-php/graphql-subscriptions",
  "support": {
    "issues": "https://github.com/ez-php/graphql-subscriptions/issues",
    "source": "https://github.com/ez-php/graphql-subscriptions"
  },
  "require": {
    "php": "^8.5",
    "webonyx/graphql-php": "^15.0",
    "ez-php/broadcast": "^2.6.0",
    "ez-php/graphql": "^2.6.0",
    "ez-php/http": "^2.6.0",
    "ez-php/websocket": "^2.6.0"
  },
  "require-dev": {
    "ez-php/docker": "^2.6.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\GraphQLSubscriptions\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
