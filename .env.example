# APP
APP_NAME=ez-php-graphql-subscriptions
APP_ENV=local
APP_DEBUG=true

# Uncomment and configure if this module requires MySQL:
# DB_HOST=db
# DB_HOST_PORT=3306
# DB_DATABASE=ez-php-graphql-subscriptions
# DB_USERNAME=ez-php-graphql-subscriptions
# DB_PASSWORD=ez-php-graphql-subscriptions
# DB_TESTING_DATABASE=ez-php-graphql-subscriptions_testing

# Uncomment and configure if this module requires Redis:
# REDIS_HOST=redis
# REDIS_PORT=6379

# Uncomment and configure if this module requires Meilisearch:
# MEILISEARCH_HOST=http://meilisearch:7700
# MEILISEARCH_KEY=
# MEILISEARCH_PORT=7700

# Uncomment and configure if this module requires Memcached:
# MEMCACHED_HOST=memcached
# MEMCACHED_PORT=11211

# Uncomment and configure if this module requires Mailpit:
# MAILPIT_HOST=mailpit
# MAILPIT_SMTP_PORT=1025
# MAILPIT_API_PORT=8025
# MAILPIT_SMTP_HOST_PORT=1025
# MAILPIT_API_HOST_PORT=8025
